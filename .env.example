# ==========================================================================
# No Under 40 — local environment. Copy to .env (`make up` does this for you).
# Key names match the existing app (canonical) so the frontend and Django agree.
# ==========================================================================

# ---- Postgres ----
POSTGRES_DB=danza
POSTGRES_USER=danza
POSTGRES_PASSWORD=danza
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433  # 5432 often taken by a local/other Postgres

# ---- Redis ----
REDIS_URL=redis://redis:6379/0
REDIS_HOST_PORT=6379

# ---- Django ----
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DJANGO_HOST_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost
CRON_SECRET=

# ---- Celery ----
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ---- Frontend / nginx ----
FRONTEND_HOST_PORT=3000
NGINX_HOST_PORT=80
NEXT_PUBLIC_APP_URL=http://localhost
# Browser calls the API same-origin via nginx (leave empty for relative /api).
NEXT_PUBLIC_API_URL=
# Server-side (SSR inside the frontend container) reaches Django by its DNS name.
DJANGO_API_URL=http://django:8000

# ---- Google OAuth ----
GOOGLE_OAUTH2_CLIENT_ID=
GOOGLE_OAUTH2_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ---- Stripe ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---- ZeptoMail ----
ZEPTO_MAIL_TOKEN=
ZEPTO_MAIL_FROM=
ZEPTO_MAIL_FROM_NAME=

# ---- Anthropic (AI-assisted translations) ----
ANTHROPIC_API_KEY=

# ==========================================================================
# Supabase — kept ONLY during the migration so the current frontend keeps
# working until Phase 7. Removed once the Django data layer is complete.
# ==========================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ==========================================================================
# Slack notifications are CI-only (GitHub Actions): push + deploy → Slack via
# chat.postMessage. Configure as GitHub repo secrets, NOT here:
#   - secret SLACK_BOT_TOKEN  (xoxb-… bot token; bot invited to the channel)
#   - target channel is set in .github/workflows/*.yaml (C0BRA32UPGR)
# ==========================================================================
