# local dev scripts (may contain credentials)
app/scripts/
scripts/
.vercel
.env*

# dump del DB di produzione scaricati da `make db-pull` (dati personali reali)
.dumps/

# test artifacts (may contain live session tokens; large trace/screenshot dumps)
tests/.auth/
test-results/
tests/load/results/
playwright-report/
blob-report/

# keep sanitized env templates trackable despite the .env* rule above
!.env*.example

