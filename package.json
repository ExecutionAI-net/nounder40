{
  "name": "nounder40",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "sync-translations": "node scripts/sync-translations.mjs",
    "test:e2e": "dotenv -e .env.test -- playwright test",
    "test:e2e:ui": "dotenv -e .env.test -- playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:auth": "dotenv -e .env.test -- playwright test --project=auth",
    "test:hq": "dotenv -e .env.test -- playwright test --project=hq",
    "test:school": "dotenv -e .env.test -- playwright test --project=school",
    "test:teacher": "dotenv -e .env.test -- playwright test --project=teacher",
    "test:student": "dotenv -e .env.test -- playwright test --project=student",
    "test:journeys": "dotenv -e .env.test -- playwright test --project=journeys",
    "test:cc": "dotenv -e .env.test -- playwright test --project=cross-cutting",
    "test:all": "dotenv -e .env.test -- playwright test",
    "test:cleanup:soft": "dotenv -e .env.test -- node scripts/cleanup.mjs soft",
    "test:cleanup": "dotenv -e .env.test -- node scripts/cleanup.mjs testdata",
    "test:cleanup:nuke": "dotenv -e .env.test -- node scripts/cleanup.mjs nuke",
    "test:reset": "dotenv -e .env.test -- node scripts/cleanup.mjs nuke && dotenv -e .env.test -- playwright test --project=setup",
    "loadtest:seed": "dotenv -e .env.local -- node tests/load/seed.mjs",
    "loadtest:teardown": "dotenv -e .env.local -- node tests/load/teardown.mjs",
    "loadtest:login": "k6 run --summary-export=tests/load/results/login.json tests/load/scenarios/login-throughput.js",
    "loadtest:booking": "k6 run --summary-export=tests/load/results/booking.json tests/load/scenarios/booking-race.js",
    "loadtest:journey": "k6 run --summary-export=tests/load/results/journey.json tests/load/scenarios/browse-and-book.js",
    "loadtest:hq": "k6 run --summary-export=tests/load/results/hq.json tests/load/scenarios/dashboard-hq.js",
    "loadtest:all": "npm run loadtest:login && npm run loadtest:booking && npm run loadtest:journey && npm run loadtest:hq"
  },
  "dependencies": {
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.100.0",
    "dompurify": "^3.4.1",
    "dotenv": "^17.3.1",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "next": "15.5.14",
    "next-intl": "^4.9.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "stripe": "^21.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.14",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
