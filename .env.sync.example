# Accesso al server di produzione per `make db-pull`, che allinea database e
# media locali a quelli di produzione. Copia questo file in .env.sync e
# riempilo: .env.sync NON va committato.

# --- Obbligatorie -----------------------------------------------------------

# Utente e host SSH del server di produzione
PROD_SSH=deploy@1.2.3.4

# Cartella sul server dove si trovano docker-compose.prod.yml e .env.prod
PROD_DIR=/srv/nounder40

# --- Media ------------------------------------------------------------------

# Percorso del volume media sul server. Se lo imposti, i file vengono presi con
# rsync incrementale (molto più veloce dalla seconda volta in poi). Richiede che
# l'utente SSH possa leggere quella cartella, che di norma appartiene a root.
# Lasciandolo vuoto si usa un tar dal container: sempre funzionante, ma
# ritrasferisce tutto ogni volta.
#PROD_MEDIA_PATH=/var/lib/docker/volumes/nounder40_media_volume/_data

# I documenti riservati (certificati medici, allegati delle chat) vivono sotto
# media/private/ e di default NON vengono scaricati: sono dati sanitari e
# personali che per fare test non servono. Metti 1 solo se ti servono davvero.
#MEDIA_PRIVATE=0

# --- Anonimizzazione --------------------------------------------------------

# Ruoli che NON vengono anonimizzati, separati da virgola. Di default restano
# intatti gli admin HQ e gli insegnanti, così puoi entrare con le loro
# credenziali di produzione. Gli account scuola vengono anonimizzati: se ti
# serve accedere anche come scuola, usa  KEEP_ROLES=hq,teacher,school
#KEEP_ROLES=hq,teacher

# --- Percorsi locali --------------------------------------------------------

# Dove salvare dump e cache dei media (default: ./.dumps)
#DUMP_DIR=./.dumps
#MEDIA_CACHE=./.dumps/media-cache
