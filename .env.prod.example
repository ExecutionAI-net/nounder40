# ==========================================================================
# No Under 40 — production environment.
# Copy to .env.prod, fill in every value below, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
# (or `make up-prod`, which does the same). Never commit .env.prod.
#
# DJANGO_SETTINGS_MODULE is NOT read from here — docker-compose.prod.yml
# pins it to config.settings.production directly on the django/celery/
# celery_beat services, so a deploy can't silently boot with DEBUG=True.
# ==========================================================================

# ---- Postgres ----
# No default password here (unlike .env.example) — docker-compose.prod.yml
# fails fast at startup if POSTGRES_PASSWORD is empty, rather than quietly
# running a production database on "danza".
POSTGRES_DB=danza
POSTGRES_USER=danza
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
# No POSTGRES_HOST_PORT — db has no published port in prod (Django/Celery
# reach it over the internal Docker network only; use `make dbshell-prod`
# or `docker compose -f docker-compose.prod.yml exec db psql ...` to connect).

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Django ----
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# Real domain(s) only — production.py has no default, an empty/wrong value
# means Django answers every request with 400 Bad Request.
DJANGO_ALLOWED_HOSTS=danzaclassicanounder40.com,www.danzaclassicanounder40.com
CORS_ALLOWED_ORIGINS=https://danzaclassicanounder40.com,https://www.danzaclassicanounder40.com
CSRF_TRUSTED_ORIGINS=https://danzaclassicanounder40.com,https://www.danzaclassicanounder40.com

# ---- Celery ----
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ---- Frontend / nginx ----
NEXT_PUBLIC_APP_URL=https://danzaclassicanounder40.com
# Browser calls the API same-origin via nginx (leave empty for relative /api).
NEXT_PUBLIC_API_URL=
# Server-side (SSR inside the frontend container) reaches Django by its DNS name.
DJANGO_API_URL=http://django:8000

# ---- Google OAuth ----
GOOGLE_OAUTH2_CLIENT_ID=
GOOGLE_OAUTH2_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ---- Stripe (live keys — sk_live_.../whsec_... from the live webhook endpoint) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Signing secret of the second event destination, the one whose "Events from"
# is set to Connected accounts. It carries account.updated (school finished
# Connect onboarding); every other handled event is a platform event and
# belongs to the secret above. Both destinations point at the same URL:
#   https://<host>/api/webhooks/stripe/
# Leave empty to run with the platform destination only.
STRIPE_CONNECT_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---- ZeptoMail ----
ZEPTO_MAIL_TOKEN=
ZEPTO_MAIL_FROM=
ZEPTO_MAIL_FROM_NAME=

# ---- Anthropic (AI-assisted translations, HQ > Translations / Email Templates) ----
ANTHROPIC_API_KEY=

# ---- Vercel-era leftover (HQ > Translations "Publish Live" button) ----
# Not applicable to this self-hosted deploy — leave empty, the endpoint
# returns "Deploy hook not configured" and the button is effectively inert.
VERCEL_DEPLOY_HOOK_URL=
